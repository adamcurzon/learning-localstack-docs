{
  "openapi": "3.0.3",
  "info": {
    "title": "Learning LocalStack API",
    "version": "1.0.0",
    "description": "A minimal Java 21 AWS Lambda exposed through API Gateway REST API. The API is deployed to AWS in eu-west-2 and can also be run locally with LocalStack."
  },
  "servers": [
    {
      "url": "https://{apiId}.execute-api.eu-west-2.amazonaws.com/{stage}",
      "description": "AWS API Gateway",
      "variables": {
        "apiId": {
          "default": "your-api-id",
          "description": "API Gateway REST API ID from the CloudFormation stack output."
        },
        "stage": {
          "default": "local",
          "description": "API Gateway stage name."
        }
      }
    },
    {
      "url": "http://{apiId}.execute-api.localhost.localstack.cloud:4566/{stage}",
      "description": "LocalStack API Gateway",
      "variables": {
        "apiId": {
          "default": "your-api-id",
          "description": "API Gateway REST API ID from the LocalStack stack output."
        },
        "stage": {
          "default": "local",
          "description": "API Gateway stage name."
        }
      }
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getApiRoot",
        "summary": "Get the API identity response",
        "description": "Returns the identity message for the Learning LocalStack API.",
        "responses": {
          "200": {
            "description": "Successful API identity response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiRootResponse"
                },
                "example": {
                  "message": "learning-localstack-api"
                }
              }
            }
          }
        }
      }
    },
    "/hello": {
      "get": {
        "operationId": "getHelloWorld",
        "summary": "Get the hello world response",
        "description": "Returns the basic hello world response from the Lambda function.",
        "responses": {
          "200": {
            "description": "Successful hello world response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloWorldResponse"
                },
                "example": {
                  "message": "hello world"
                }
              }
            }
          }
        }
      }
    },
    "/ping": {
      "get": {
        "operationId": "getPing",
        "summary": "Get the pong response",
        "description": "Returns a pong response for health checks and connectivity tests.",
        "responses": {
          "200": {
            "description": "Successful ping response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                },
                "example": {
                  "message": "pong"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HelloWorldResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "hello world"
          }
        }
      },
      "PingResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "pong"
          }
        }
      },
      "ApiRootResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "learning-localstack-api"
          }
        }
      }
    }
  }
}
